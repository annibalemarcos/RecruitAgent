# GEMINI_API_KEY: Obtenha sua chave gratuita em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# OPENAI_API_KEY (Opcional): Para habilitar o ChatGPT / OpenAI (GPT-4o, GPT-4o-mini)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# PERPLEXITY_API_KEY (Opcional): Para habilitar busca web em tempo real e contingência via Perplexity AI (sonar, sonar-pro)
# Obtenha sua chave em: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=""

# APP_URL: URL onde o aplicativo está rodando localmente
APP_URL="http://localhost:3000"

# PORT: Porta local
PORT="3000"

# Busca web: Brave -> You.com -> Exa -> Tavily (somente APIs configuradas)
BRAVE_SEARCH_API_KEY=""
YOU_API_KEY=""
# YDC_API_KEY tambem e aceito como alias para YOU_API_KEY
EXA_API_KEY=""
TAVILY_API_KEY=""
WEB_SEARCH_PROVIDER="auto"
SEARCH_MAX_RESULTS="5"

# Leitura: HTTP direto -> Firecrawl -> You.com Contents
FIRECRAWL_API_KEY=""
RENDER_PAGES_WITHOUT_EMAIL="true"

# IA adicional: prioridade escolhida na interface, depois demais provedores
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
ABSTRACT_API_KEY=""

# Limite de chamadas de busca/leitura por empresa (nao inclui geracao de materiais)
EXTERNAL_API_MAX_CALLS_PER_COMPANY="12"
EXTERNAL_API_TIMEOUT_MS="20000"
