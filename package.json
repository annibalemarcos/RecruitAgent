{
  "name": "agente-de-recrutamento-candidaturas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:emails": "node --import tsx tests/test-email-verification.ts",
    "test:integrations": "node --import tsx tests/test-integrations.ts",
    "test": "npm run test:emails && npm run test:integrations && npm run test:materials && npm run test:legal && npm run test:keys && npm run test:profiles",
    "test:materials": "node --import tsx tests/test-spontaneous-materials.ts",
    "test:legal": "node --import tsx tests/test-legal-email-fallback.ts",
    "test:keys": "node --import tsx tests/test-api-credentials-json.ts",
    "test:profiles": "node --import tsx tests/test-saved-profiles.ts",
    "test:reset": "node --import tsx tests/test-data-reset.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "docx": "^9.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "openai": "^7.27.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
